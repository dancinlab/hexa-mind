#!hexa strict
// hexa-mind/cli/hexa-mind.hexa — standalone hexa-mind CLI router (🧠)
//
// 7-verb mental-substrate dispatcher:
//   mind  neuro  oracle  hexa_telepathy  telepathy  mind_upload  superpowers
//
// 4 of 7 verbs are SPECULATIVE — see hexa.toml [speculation] for honesty.

let VERSION = "1.0.0"

let HOME = env("HOME")
let HEXA_MIND_ROOT_ENV = env("HEXA_MIND_ROOT")

fn hexa_mind_root() -> str {
    if HEXA_MIND_ROOT_ENV.len() > 0 { return HEXA_MIND_ROOT_ENV }
    let inferred = exec("dirname \"$(dirname \"$0\")\" 2>/dev/null || true").trim()
    if inferred.len() > 0 { return inferred }
    return HOME + "/.hexa-mind"
}

let HM = hexa_mind_root()
let LOG_PATH = HM + "/state/hexa_mind_cli.log"

fn verb_spec(verb: str) -> str {
    if verb == "mind"           { return HM + "/mind/hexa-mind.md" }
    if verb == "neuro"          { return HM + "/neuro/hexa-neuro.md" }
    if verb == "oracle"         { return HM + "/oracle/hexa-oracle.md" }
    if verb == "hexa_telepathy" { return HM + "/hexa_telepathy/hexa-telepathy.md" }
    if verb == "telepathy"      { return HM + "/telepathy/telepathy.md" }
    if verb == "mind_upload"    { return HM + "/mind_upload/mind-upload.md" }
    if verb == "superpowers"    { return HM + "/superpowers/superpowers.md" }
    return ""
}

let VERBS = ["mind", "neuro", "oracle", "hexa_telepathy", "telepathy", "mind_upload", "superpowers"]
let SPECULATIVE = ["oracle", "hexa_telepathy", "telepathy", "mind_upload"]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn has_flag(a: [str], flag: str) -> bool {
    for x in a {
        if x == flag { return true }
    }
    return false
}

fn json_mode(a: [str]) -> bool {
    return has_flag(a, "--json")
}

fn _ts_now() -> str { return exec("date -u '+%Y-%m-%dT%H:%M:%SZ'").trim() }

fn _audit(subcmd: str, args_str: str, exit_code: int) {
    let line = "{\"ts\":\"" + _ts_now() + "\",\"caller\":\"hexa_mind_standalone\",\"subcmd\":\"hexa-mind " +
               subcmd + "\",\"exit_code\":" + str(exit_code) + ",\"version\":\"" + VERSION + "\"}"
    exec("mkdir -p " + shq(HM + "/state") + " 2>/dev/null")
    exec("echo " + shq(line) + " >> " + shq(LOG_PATH) + " 2>/dev/null")
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn _is_speculative(verb: str) -> bool {
    for s in SPECULATIVE { if s == verb { return true } }
    return false
}

fn _print_caveats() {
    println("")
    println("  1. SPEC_CATALOG_ONLY at v1.0.0. 0/7 verbs ship a working .hexa.")
    println("  2. SPECULATIVE verbs (4/7): oracle (quantum), hexa_telepathy +")
    println("     telepathy (brain-to-brain entanglement), mind_upload")
    println("     (consciousness uploading) — preregistered, not validated.")
    println("  3. Sister-rollup of hexa-codex (knowledge) / hexa-senses (👁️) /")
    println("     hexa-brain (BCI) / anima (consciousness).")
}

fn cmd_list(a: [str]) {
    if json_mode(a) {
        let mut js = "{\"hexa_mind\":\"" + VERSION + "\",\"verbs_total\":7,"
        js = js + "\"verbs\":[\"mind\",\"neuro\",\"oracle\",\"hexa_telepathy\",\"telepathy\",\"mind_upload\",\"superpowers\"],"
        js = js + "\"speculative\":[\"oracle\",\"hexa_telepathy\",\"telepathy\",\"mind_upload\"],"
        js = js + "\"verdict\":\"SPEC_CATALOG_ONLY\"}"
        println(js)
        return
    }
    println("hexa-mind " + VERSION + " — 7-verb mental substrate (🧠)")
    println("")
    println("  GROUNDED (3):    mind  neuro  superpowers")
    println("  SPECULATIVE (4): oracle  hexa_telepathy  telepathy  mind_upload")
    println("")
    println("  to read a verb spec:")
    println("    hexa-mind <verb>          (prints verb spec path + first lines)")
    println("    hexa-mind selftest        (7-verb spec presence sweep)")
    println("    hexa-mind verify [check]  (Python verifier dispatcher)")
    _print_caveats()
}

fn cmd_verb(verb: str, a: [str]) {
    let spec = verb_spec(verb)
    if spec == "" {
        eprintln("hexa-mind: unknown verb '" + verb + "'")
        eprintln("run 'hexa-mind list' for the 7-verb table")
        _audit(verb, "unknown", 2)
        exit(2)
    }
    let present = _file_exists(spec)
    let mut tag = ""
    if _is_speculative(verb) { tag = " (SPECULATIVE)" }
    println("hexa-mind " + verb + tag + " — mental substrate (v" + VERSION + " spec)")
    println("  spec_path: " + spec)
    if present == false {
        eprintln("  status: MISSING")
        _audit(verb, "missing", 1)
        exit(1)
    }
    println("  status: PRESENT")
    println("  --- first 20 lines ---")
    let head = exec("head -20 " + shq(spec) + " 2>/dev/null")
    println(head.trim())
    println("  ----------------------")
    if json_mode(a) {
        let mut js = "{\"hexa_mind\":\"" + VERSION + "\",\"verb\":\"" + verb + "\",\"present\":true"
        if _is_speculative(verb) { js = js + ",\"speculative\":true" }
        js = js + "}"
        println(js)
    }
    _audit(verb, "", 0)
}

fn cmd_selftest(a: [str]) {
    let mut ok = 0
    let mut miss: [str] = []
    for v in VERBS {
        let spec = verb_spec(v)
        if _file_exists(spec) { ok = ok + 1 } else { miss = miss + [v] }
    }
    let total = len(VERBS)
    println("hexa-mind selftest — verb-spec presence sweep")
    println("  total verbs: " + str(total))
    println("  rollup:      mind+neuro+oracle+hexa_telepathy+telepathy+mind_upload+superpowers")
    println("  present:     " + str(ok) + "/" + str(total))
    if ok == total {
        println("__HEXA_MIND_SELFTEST__ PASS")
        if json_mode(a) {
            println("{\"hexa_mind\":\"" + VERSION + "\",\"verdict\":\"PASS\",\"present\":" + str(ok) + ",\"total\":" + str(total) + "}")
        }
        _print_caveats()
        _audit("selftest", "", 0)
        return
    }
    println("__HEXA_MIND_SELFTEST__ FAIL")
    for m in miss { println("  missing: " + m) }
    _print_caveats()
    _audit("selftest", "", 1)
    exit(1)
}

fn cmd_verify(a: [str]) {
    let mut target = "all"
    if a.len() > 3 {
        let cand = a[3]
        if cand.starts_with("--") == false { target = cand }
    }
    let mut tail = ""
    if json_mode(a) { tail = " --json" }
    let cmd = "cd " + shq(HM) + " && python3 verify/cli.py " + shq(target) + tail
    let rc = exec(cmd)
    print(rc)
    _audit("verify", target, 0)
}

fn cmd_inventory(a: [str]) {
    let mut tail = ""
    if json_mode(a) { tail = " --json" }
    let cmd = "cd " + shq(HM) + " && python3 verify/spec_inventory.py" + tail
    let rc = exec(cmd)
    print(rc)
    _audit("inventory", "", 0)
}

fn cmd_version() {
    println("hexa-mind " + VERSION)
    println("standalone mental-substrate library (extracted from canon@dbd2420d on 2026-05-07)")
    println("license: MIT")
    println("repo:    https://github.com/dancinlab/hexa-mind")
}

fn cmd_help() {
    println("hexa-mind " + VERSION + " — 7-verb mental-substrate CLI (🧠)")
    println("")
    println("usage: hexa-mind <subcmd> [flags...]")
    println("")
    println("verb subcommands:")
    println("  mind             mental architecture core")
    println("  neuro            neural interface substrate")
    println("  oracle           6-qubit quantum predictor (SPECULATIVE)")
    println("  hexa_telepathy   quantum-entangled brain-to-brain (SPECULATIVE)")
    println("  telepathy        bilateral BCI telepathy (SPECULATIVE)")
    println("  mind_upload      consciousness upload (SPECULATIVE)")
    println("  superpowers      BCI + exoskeleton augmentation")
    println("")
    println("utility subcommands:")
    println("  list             verb table + caveats")
    println("  selftest         7-verb spec presence sweep")
    println("  verify [check]   Python verifier dispatcher")
    println("  inventory        spec presence + canonical-header audit")
    println("")
    println("global flags:")
    println("  --version        show version")
    println("  --json           machine-parseable JSON tail")
    println("  --help, -h       this help")
    println("")
    println("env:")
    println("  HEXA_MIND_ROOT       override repo root")
}

fn main() {
    let _raw = args()
    let mut _sidx = -1
    let mut _i = 0
    while _i < _raw.len() {
        if _raw[_i].ends_with(".hexa") { _sidx = _i; break }
        _i = _i + 1
    }
    let mut _user_start = 2
    if _sidx >= 0 { _user_start = _sidx + 1 }

    let mut a: [str] = ["hexa_mind_cli", "hexa_mind_router"]
    let mut _ua = _user_start
    while _ua < _raw.len() {
        a = a + [_raw[_ua]]
        _ua = _ua + 1
    }
    let n = len(a)

    if n < 3 { cmd_help(); return }

    let sub = a[2]

    if sub == "--version" || sub == "-V" || sub == "version" { cmd_version(); return }
    if has_flag(a, "--help") || has_flag(a, "-h") { cmd_help(); return }
    if sub == "help"      { cmd_help(); return }
    if sub == "list"      { cmd_list(a); return }
    if sub == "selftest"  { cmd_selftest(a); return }
    if sub == "verify"    { cmd_verify(a); return }
    if sub == "inventory" { cmd_inventory(a); return }

    if verb_spec(sub) != "" { cmd_verb(sub, a); return }

    eprintln("hexa-mind: unknown subcommand '" + sub + "'")
    eprintln("run 'hexa-mind help' or 'hexa-mind list' for usage")
    _audit(sub, "", 2)
    exit(2)
}
